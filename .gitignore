# Upstream sources the workflow checks out into the package directories; they are
# not part of this repository
/dae/src/
/honk/src/

# Build outputs of the dae/honk package builds
/dae/dist/
/honk/dist/
/dist/

# Signing key of the package feed. The private half is the PRIVATE_KEY secret of
# the workflow and must never be committed; the workflow restores it to this path
# from the secret (scripts/setup-signing-key.sh), keys/public-key.pem is the
# published half and belongs in the repository.
/keys/private-key.pem

# Bytecode caches of the feed-site generator and its tests
__pycache__/
