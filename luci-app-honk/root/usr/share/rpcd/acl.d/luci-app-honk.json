{
	"luci-app-honk": {
		"description": "Grant access to the honk configuration and log",
		"read": {
			"file": {
				"/etc/honk": [ "list" ],
				"/etc/honk/*": [ "list", "read" ]
			},
			"ubus": {
				"file": [ "list", "read" ],
				"log": [ "read" ],
				"service": [ "list" ]
			},
			"uci": [ "honk", "dae", "network" ]
		},
		"write": {
			"file": {
				"/etc/honk/*": [ "write" ],
				"/usr/bin/apk": [ "exec" ]
			},
			"ubus": {
				"file": [ "write", "exec" ],
				"rc": [ "init" ]
			},
			"uci": [ "honk", "dae" ]
		}
	}
}
