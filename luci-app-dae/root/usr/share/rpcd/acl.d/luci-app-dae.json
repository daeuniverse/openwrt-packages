{
	"luci-app-dae": {
		"description": "Grant access to the dae configuration and log",
		"read": {
			"file": {
				"/etc/dae": [ "list" ],
				"/etc/dae/*": [ "list", "read" ],
				"/usr/libexec/daeuniverse-pkg installed *": [ "exec" ],
				"/usr/libexec/daeuniverse-pkg check *": [ "exec" ],
				"/usr/libexec/daeuniverse-pkg status": [ "exec" ]
			},
			"ubus": {
				"file": [ "list", "read", "exec" ],
				"log": [ "read" ],
				"service": [ "list" ]
			},
			"uci": [ "dae", "honk" ]
		},
		"write": {
			"file": {
				"/etc/dae/*": [ "write" ],
				"/usr/libexec/daeuniverse-pkg upgrade *": [ "exec" ],
				"/usr/bin/dae validate -c *": [ "exec" ]
			},
			"ubus": {
				"file": [ "write", "exec" ],
				"rc": [ "init" ]
			},
			"uci": [ "dae", "honk" ]
		}
	}
}
