#!/bin/sh /etc/rc.common
#
# OpenWrt procd init script for honk (honk-core).
#
# UCI (/etc/config/honk):
#
#   config honk 'config'
#       option enabled '0'
#       option config_file '/etc/honk/config.dae'
#
# honk-core runs as root: its eBPF datapath creates the dae0 link pair and the
# daens network namespace, attaches TC programs and may open NFQUEUE.

USE_PROCD=1
START=99
STOP=01

CONF="honk"
PROG="/usr/bin/honk-core"

start_service() {
	config_load "$CONF"

	local enabled
	config_get_bool enabled "config" "enabled" 0
	[ "$enabled" -eq 1 ] || return 1

	# dae creates the same dae0 link pair and daens namespace and hooks the
	# same interfaces, so the two never run at the same time. LuCI turns
	# dae off when honk is turned on there; with both turned on by hand,
	# the one started second refuses. A dae that is turned off is only
	# on its way out (it takes a moment to detach), so it does not block;
	# should it still hold the link pair, procd restarts honk shortly after.
	if [ "$(uci -q get dae.config.enabled)" = 1 ] &&
		ubus call service list '{"name":"dae"}' 2>/dev/null |
		jsonfilter -q -e '@.dae.instances[*].running' | grep -q true; then
		logger -t honk "dae is running; honk and dae cannot run at the same time, disable dae first"
		return 1
	fi

	local config_file
	config_get config_file "config" "config_file" "/etc/honk/config.dae"

	if [ ! -r "$config_file" ]; then
		logger -t honk "configuration file '$config_file' is missing or unreadable"
		return 1
	fi

	# apk does not stop at the failed check of vmlinux-btf-builtin, so a kernel
	# without BTF can still get here
	if [ ! -e /sys/kernel/btf/vmlinux ] && [ ! -e /usr/lib/debug/boot/vmlinux ]; then
		logger -t honk "the kernel has no BTF: add the kmods repository, then run 'apk update && apk upgrade vmlinux-btf-builtin'"
		return 1
	fi

	# aya pins its maps below --bpf-pin-root (default /sys/fs/bpf), and OpenWrt
	# does not mount bpffs by itself. BusyBox has no mountpoint applet, so look
	# it up in /proc/mounts; a second mount would stack on the first. It is
	# left mounted on stop because other tools may share it.
	grep -qs ' /sys/fs/bpf bpf ' /proc/mounts || mount -t bpf bpf /sys/fs/bpf

	procd_open_instance "$CONF"
	procd_set_param command "$PROG" --config "$config_file"
	# honk budgets its flow admission from RLIMIT_NOFILE (it raises the soft
	# limit to the hard limit); keep the hard limit high enough for a gateway.
	procd_set_param limits core="unlimited" nofile="1048576 1048576"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	# Also the reload trigger of /etc/config/honk. An instance that runs with the
	# configured file only rereads it. Everything else goes through start,
	# which procd turns into a start, a restart when the command line changed
	# (another configuration file), or a stop when start_service adds no
	# instance (turned off, or the other service runs). Unlike stop, that keeps
	# the service and its triggers registered, so turning it on again works.
	config_load "$CONF"

	local enabled config_file
	config_get_bool enabled "config" "enabled" 0
	config_get config_file "config" "config_file" "/etc/honk/config.dae"
	if [ "$enabled" -eq 1 ] && procd_running "$CONF" "$CONF" &&
		ubus call service list "{\"name\":\"$CONF\"}" 2>/dev/null |
		jsonfilter -q -e "@.$CONF.instances.$CONF.command[*]" | grep -qxF -- "$config_file"; then
		# `honk-core reload` reads the instance lock and sends SIGHUP, so a
		# stale instance is reported instead of signalling an unrelated PID.
		"$PROG" reload
	else
		start
	fi
}

service_triggers() {
	procd_add_reload_trigger "$CONF"
}
