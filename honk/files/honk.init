#!/bin/sh /etc/rc.common
# These come first: rpcd's rc list reads START and STOP only near the top of the file.
USE_PROCD=1
START=99
STOP=01
#
# OpenWrt procd init script for honk (honk-core).
#
# UCI (/etc/config/honk):
#
#   config honk 'config'
#       option config_file '/etc/honk/config.dae'
#
# Starting at boot is the rc.d link, not a UCI option: /etc/init.d/honk enable
# or disable. Start, stop and restart always work.
#
# honk-core runs as root: its eBPF datapath creates the dae0 link pair and the
# daens network namespace, attaches TC programs and may open NFQUEUE.

CONF="honk"
PROG="/usr/bin/honk-core"

start_service() {
	config_load "$CONF"

	# The package scripts of apk start every init script their package ships: a
	# fresh install after enabling it (it stays off until the user turns it on),
	# an upgrade only if it was on. They export pkgname, and PKG_UPGRADE=1 on an
	# upgrade; a start by hand sets neither.
	if [ "$pkgname" = "$CONF" ]; then
		if [ "$PKG_UPGRADE" != 1 ]; then
			disable
			return 1
		fi
		enabled || return 1
	fi

	# dae creates the same dae0 link pair and daens namespace and hooks the
	# same interfaces, so the two never run at the same time. LuCI stops dae
	# before it starts honk; started any other way while dae runs, honk
	# refuses. A dae that is stopping can still hold the link pair for a
	# moment; procd restarts honk shortly after.
	if ubus call service list '{"name":"dae"}' 2>/dev/null |
		jsonfilter -q -e '@.dae.instances[*].running' | grep -q true; then
		logger -t honk "dae is running; honk and dae cannot run at the same time, stop dae first"
		return 1
	fi

	local config_file
	config_get config_file "config" "config_file" "/etc/honk/config.dae"

	if [ ! -r "$config_file" ]; then
		logger -t honk "configuration file '$config_file' is missing or unreadable"
		return 1
	fi

	# apk does not stop at the failed check of vmlinux-btf-builtin, so a kernel
	# without BTF can still get here
	if [ ! -e /sys/kernel/btf/vmlinux ] && [ ! -e /usr/lib/debug/boot/vmlinux ]; then
		logger -t honk "the kernel has no BTF: add the kmods repository, then run 'apk update && apk upgrade vmlinux-btf-builtin'"
		return 1
	fi

	# aya pins its maps below --bpf-pin-root (default /sys/fs/bpf), and OpenWrt
	# does not mount bpffs by itself. BusyBox has no mountpoint applet, so look
	# it up in /proc/mounts; a second mount would stack on the first. It is
	# left mounted on stop because other tools may share it.
	grep -qs ' /sys/fs/bpf bpf ' /proc/mounts || mount -t bpf bpf /sys/fs/bpf

	# procd runs each instance in /sys/fs/cgroup/services/<service>/<instance>
	# but enables no controller there, so honk finds no memory.current and its
	# telemetry has no cgroup reading. Enable the memory controller down to the
	# service cgroup before procd moves the instance in (honk checks for the
	# cgroup files once, at startup). The cgroup is kept on stop.
	local cgroup
	if grep -qsw memory /sys/fs/cgroup/cgroup.controllers; then
		mkdir -p "/sys/fs/cgroup/services/$CONF"
		for cgroup in /sys/fs/cgroup /sys/fs/cgroup/services "/sys/fs/cgroup/services/$CONF"; do
			echo +memory > "$cgroup/cgroup.subtree_control" ||
				logger -t honk "cannot enable the memory controller in $cgroup"
		done
	fi

	procd_open_instance "$CONF"
	procd_set_param command "$PROG" --config "$config_file"
	# honk budgets its flow admission from RLIMIT_NOFILE (it raises the soft
	# limit to the hard limit); keep the hard limit high enough for a gateway.
	procd_set_param limits core="unlimited" nofile="1048576 1048576"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	# Also the reload trigger of /etc/config/honk. A stopped service stays
	# stopped. An instance that runs with the configured file only rereads it.
	# Otherwise it goes through start, which procd turns into a restart (another
	# configuration file) or a stop when start_service adds no instance (the
	# file is missing or fails validation). Unlike stop, that keeps the service
	# and its triggers registered, so starting it again works.
	config_load "$CONF"

	local config_file
	config_get config_file "config" "config_file" "/etc/honk/config.dae"
	procd_running "$CONF" "$CONF" || return 0
	if ubus call service list "{\"name\":\"$CONF\"}" 2>/dev/null |
		jsonfilter -q -e "@.$CONF.instances.$CONF.command[*]" | grep -qxF -- "$config_file"; then
		# `honk-core reload` reads the instance lock and sends SIGHUP, so a
		# stale instance is reported instead of signalling an unrelated PID.
		"$PROG" reload
	else
		start
	fi
}

service_triggers() {
	procd_add_reload_trigger "$CONF"
}
