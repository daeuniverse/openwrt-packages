#!/bin/sh /etc/rc.common
# These come first: rpcd's rc list reads START and STOP only near the top of the file.
USE_PROCD=1
START=99
STOP=01
#
# OpenWrt procd init script for dae.
#
# UCI (/etc/config/dae):
#
#   config dae 'config'
#       option config_file '/etc/dae/config.dae'
#
# Starting at boot is the rc.d link, not a UCI option: /etc/init.d/dae enable
# or disable. Start, stop and restart always work.
#
# dae runs as root because its eBPF datapath attaches to the LAN/WAN
# interfaces and creates the daens network namespace.

CONF="dae"
PROG="/usr/bin/dae"

start_service() {
	config_load "$CONF"

	# The package scripts of apk start every init script their package ships: a
	# fresh install after enabling it (it stays off until the user turns it on),
	# an upgrade only if it was on. They export pkgname, and PKG_UPGRADE=1 on an
	# upgrade; a start by hand sets neither.
	if [ "$pkgname" = "$CONF" ]; then
		if [ "$PKG_UPGRADE" != 1 ]; then
			disable
			return 1
		fi
		enabled || return 1
	fi

	# honk creates the same dae0 link pair and daens namespace and hooks the
	# same interfaces, so the two never run at the same time. LuCI stops honk
	# before it starts dae; started any other way while honk runs, dae
	# refuses. A honk that is stopping can still hold the link pair for a
	# moment; procd restarts dae shortly after.
	if ubus call service list '{"name":"honk"}' 2>/dev/null |
		jsonfilter -q -e '@.honk.instances[*].running' | grep -q true; then
		logger -t dae "honk is running; dae and honk cannot run at the same time, stop honk first"
		return 1
	fi

	local config_file
	config_get config_file "config" "config_file" "/etc/dae/config.dae"

	if [ ! -r "$config_file" ]; then
		logger -t dae "configuration file '$config_file' is missing or unreadable"
		return 1
	fi

	# apk does not stop at the failed check of vmlinux-btf-builtin, so a kernel
	# without BTF can still get here
	if [ ! -e /sys/kernel/btf/vmlinux ] && [ ! -e "/usr/lib/debug/boot/vmlinux-$(uname -r)" ]; then
		logger -t dae "the kernel has no BTF: add the kmods repository, then run 'apk update && apk upgrade vmlinux-btf-builtin'"
		return 1
	fi

	# `validate` runs the same rule pipeline as `run` (alias resolution,
	# geosite/geoip expansion, rule lowering) without touching the eBPF
	# datapath, so a broken configuration fails before the running instance
	# is replaced. Geo assets are resolved locally, never downloaded.
	if ! "$PROG" validate -c "$config_file"; then
		logger -t dae "configuration '$config_file' failed validation"
		return 1
	fi

	procd_open_instance "$CONF"
	procd_set_param command "$PROG" run --config "$config_file"
	# dae budgets its flow tables from RLIMIT_NOFILE, so keep the hard limit high
	procd_set_param limits core="unlimited" nofile="1000000 1000000"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	# Also the reload trigger of /etc/config/dae. A stopped service stays
	# stopped. An instance that runs with the configured file only rereads it.
	# Otherwise it goes through start, which procd turns into a restart (another
	# configuration file) or a stop when start_service adds no instance (the
	# file is missing or fails validation). Unlike stop, that keeps the service
	# and its triggers registered, so starting it again works.
	config_load "$CONF"

	local config_file
	config_get config_file "config" "config_file" "/etc/dae/config.dae"
	procd_running "$CONF" "$CONF" || return 0
	if ubus call service list "{\"name\":\"$CONF\"}" 2>/dev/null |
		jsonfilter -q -e "@.$CONF.instances.$CONF.command[*]" | grep -qxF -- "$config_file"; then
		# dae reloads on SIGUSR1 (what `dae reload` sends) and keeps established
		# connections; it ignores SIGHUP.
		procd_send_signal "$CONF" "$CONF" USR1
	else
		start
	fi
}

service_triggers() {
	procd_add_reload_trigger "$CONF"
}
