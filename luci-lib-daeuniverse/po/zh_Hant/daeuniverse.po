msgid ""
msgstr ""
"Language: zh_Hant\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"

msgid "(new)"
msgstr "（新檔案）"

msgid "Configuration file"
msgstr "設定檔"

msgid "Configuration is invalid, the service was not reloaded"
msgstr "設定有誤，服務未重新載入"

msgid "Unable to read %s: %s"
msgstr "無法讀取 %s：%s"

msgid "Edit the configuration file and every file it includes; each tab is saved to its own file."
msgstr "編輯設定檔及其 include 的所有檔案，每個分頁儲存到各自的檔案。"

msgid "Log"
msgstr "日誌"

msgid "Must be a file in %s"
msgstr "必須是 %s 中的檔案"

msgid "No log entries."
msgstr "尚無日誌。"

msgid "Not running"
msgstr "未執行"

msgid "Re-read includes"
msgstr "重新解析 include"

msgid "Running"
msgstr "執行中"

msgid "Save files"
msgstr "儲存檔案"

msgid "Saved"
msgstr "已儲存"

msgid "Saved, but the service could not be reloaded: %s"
msgstr "已儲存，但無法重新載入服務：%s"

msgid "Saved, the service is reloading"
msgstr "已儲存，服務正在重新載入"

msgid "Status"
msgstr "狀態"

msgid "Unable to save: %s"
msgstr "儲存失敗：%s"

msgid "Service status"
msgstr "服務狀態"

msgid "Configuration"
msgstr "設定"

msgid "Refresh"
msgstr "重新整理"

msgid "Web interface"
msgstr "網頁介面"

msgid "Open doona"
msgstr "開啟 doona"

msgid "doona listens on %s; open it through an SSH tunnel:"
msgstr "doona 監聽 %s；請透過 SSH 通道存取："

msgid "To open it from the LAN instead, set %s and restart honk."
msgstr "若要從區域網路直接開啟，請設定 %s 並重新啟動 honk。"

msgid "honk only accepts IP addresses; open LuCI by IP address."
msgstr "honk 僅接受 IP 位址；請使用 IP 位址開啟 LuCI。"

msgid "Version"
msgstr "版本"

msgid "Check for updates"
msgstr "檢查更新"

msgid "Checking for updates…"
msgstr "正在檢查更新…"

msgid "Up to date"
msgstr "已是最新版本"

msgid "Upgrade"
msgstr "升級"

msgid "Select the packages to upgrade:"
msgstr "選擇要升級的套件："

msgid "Upgrading restarts the service and interrupts connections for a few seconds. Continue?"
msgstr "升級將重新啟動服務，連線將中斷數秒。是否繼續？"

msgid "Upgrading…"
msgstr "正在升級…"

msgid "Upgrade complete."
msgstr "升級完成。"

msgid "apk exited with code %s."
msgstr "apk 執行失敗，結束代碼為 %s。"

msgid "To use this feed's version, run %s; other packages can be added to the same command."
msgstr "如需改用本軟體源的版本，請執行 %s；其他套件可加入同一條命令。"

msgid "Unable to read version: %s"
msgstr "無法讀取版本：%s"

msgid "Not installed"
msgstr "未安裝"

msgid "Cancel"
msgstr "取消"

msgid "Close"
msgstr "關閉"

msgid "Package index update failed; using available indexes."
msgstr "套件索引更新失敗；將使用可用的索引。"

msgid "An upgrade is already running."
msgstr "已有升級工作正在執行。"

msgid "These packages were not upgraded: %s"
msgstr "以下套件未升級：%s"

msgid "Waiting for the package manager to reconnect…"
msgstr "正在等待套件管理員重新連線…"

msgid "Unable to read upgrade status. The job may still be running; reload to reconnect."
msgstr "無法讀取升級狀態。工作可能仍在執行；請重新載入頁面以恢復連線。"

msgid "Enable the doona web UI"
msgstr "啟用 doona 網頁介面"

msgid "Unchecked, honk runs without the native API and doona. Saving restarts honk."
msgstr "取消勾選後，honk 只運行核心，不啟用 native API 與 doona。儲存時會重新啟動 honk。"

msgid "Saved, the service is restarting"
msgstr "已儲存，服務正在重新啟動"

msgid "Saved, but the service could not be restarted: %s"
msgstr "已儲存，但無法重新啟動服務：%s"

msgid "Save or discard the unsaved changes of %s first"
msgstr "請先儲存或放棄 %s 尚未儲存的編輯"

msgid "Start"
msgstr "啟動"

msgid "Stop"
msgstr "停止"

msgid "Restart"
msgstr "重新啟動"

msgid "Stopping the service interrupts connections. Continue?"
msgstr "停止服務會中斷連線。是否繼續？"

msgid "Restarting the service interrupts connections for a few seconds. Continue?"
msgstr "重新啟動服務會使連線中斷數秒。是否繼續？"

msgid "The service started"
msgstr "服務已啟動"

msgid "The service stopped"
msgstr "服務已停止"

msgid "The service restarted"
msgstr "服務已重新啟動"

msgid "The service did not start, see the Log tab."
msgstr "服務未能啟動，請查看「日誌」分頁。"

msgid "The service did not stop."
msgstr "服務未能停止。"

msgid "The service action failed: %s"
msgstr "服務操作失敗：%s"

msgid "Start at boot"
msgstr "開機自動啟動"

msgid "Starts automatically when the router boots; does not change whether it is running now."
msgstr "路由器開機時自動啟動；不影響目前是否正在執行。"

msgid "Start at boot is on"
msgstr "已開啟開機自動啟動"

msgid "Start at boot is off"
msgstr "已關閉開機自動啟動"

msgid "Start at boot is on; %s no longer starts at boot, because dae and honk cannot run at the same time."
msgstr "已開啟開機自動啟動。dae 和 honk 不能同時執行，%s 不再開機自動啟動。"

msgid "Unable to change Start at boot: %s"
msgstr "無法變更開機自動啟動：%s"

msgid "%s was stopped first, because dae and honk cannot run at the same time."
msgstr "dae 和 honk 不能同時執行，已先停止 %s。"

msgid "%s did not stop, the service was not started."
msgstr "%s 未能停止，服務未啟動。"
